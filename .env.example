# Postgres connection string (Neon via Vercel Marketplace, or any Postgres instance)
DATABASE_URL=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB v4 Read Access Token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Secret checked against the Authorization header on cron-triggered requests
# (Vercel sets this automatically for Cron Jobs on deploy; generate your own
# for local testing, e.g. `openssl rand -hex 16`)
CRON_SECRET=
